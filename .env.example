# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ravindu_portfolio

# Allowed frontend origin (for CORS in dev, e.g. Live Server on port 5500)
CLIENT_URL=http://localhost:5500

# SMTP email delivery (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ravinduravisara@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_EMAIL=ravinduravisara@gmail.com
